{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lavinia Client",
  "version": "0.1.0",
  "identifier": "os.lavinia.client",
  "build": {
    "frontendDist": "../src/ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix src/ui run dev",
    "beforeBuildCommand": "npm --prefix src/ui run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Lavinia Client",
        "width": 460,
        "height": 740,
        "resizable": false,
        "maximizable": false,
        "visible": false,
        "backgroundColor": "#0b0d14"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost https://asset.localhost data:; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"],
    "resources": [
      "resources/bin/*",
      "wintun.dll"
    ]
  }
}
